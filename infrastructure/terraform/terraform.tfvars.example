# Example Terraform variables for Ops23-NR (Phase 3A)
# Copy to terraform.tfvars to customize for your AWS environment

aws_region          = "ap-south-1"
project_name        = "Ops23-NR"
environment         = "dev"
instance_type       = "t3.micro"
allowed_cidr_blocks = ["0.0.0.0/0"] # Restrict to your IP or VPC CIDR in production environments
root_volume_size    = 20
